#!/usr/bin/env python3
"""secret-leak-scan: find secrets that leaked into local transcripts/logs.

Two detectors, both value-blind on output:
  1. vault exact-match: loads CONCEALED field values of the agent vaults
     (default: `vaults=` in ~/.config/secret-hygiene/config, else eko) through the 1Password service account, in this
     process only, and greps the files for them (grep -F, patterns in a 0600
     temp file removed in `finally`).
  2. gitleaks pattern scan (`gitleaks dir`), report in a 0600 temp file,
     removed in `finally`.

Output never contains a secret value: only path, line, kind/rule, item title,
sha256[:8] and a context snippet where every known value and every long
token-like run is masked.

Usage:
  secret-leak-scan [--days 30] [--no-vault] [--no-gitleaks] [--json OUT]
                   [--patterns-file FILE] ROOT...

--patterns-file FILE  use literal values from FILE (one per line) instead of
                      the vault; for tests with FAKE secrets.
Exit: 0 no finding, 1 findings, 2 error, 3 vault not measured (quota).
"""
import argparse, hashlib, json, os, re, shutil, subprocess, sys, tempfile, time

def local_config():
    """Optional ~/.config/secret-hygiene/config with key=value lines:
    vaults=eko,other  sa_env=/path/to/sa.env"""
    c = {}
    try:
        for line in open(os.path.expanduser("~/.config/secret-hygiene/config")):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                c[k.strip()] = v.strip()
    except OSError:
        pass
    return c


CONF = local_config()
SA_ENV = os.path.expanduser(CONF.get("sa_env", "~/.config/op/service-accounts/ai-agents.env"))
MIN_LEN = 10
THROTTLE = 0.6
TOKENISH = re.compile(r"[A-Za-z0-9_\-+/=.]{20,}")


def h8(v):
    return hashlib.sha256(v.encode("utf-8", "surrogateescape")).hexdigest()[:8]


def sa_env():
    env = {k: v for k, v in os.environ.items()
           if not k.startswith("OP_SESSION_") and k != "OP_DEVICE"}
    with open(SA_ENV) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k = k.replace("export ", "").strip()
            env[k] = v.strip().strip('"').strip("'")
    return env


STATE = {"aborted": False}
GL_CFG = os.path.join(os.path.dirname(os.path.realpath(__file__)), "gitleaks-agent.toml")
RESERVE = 300  # reads left untouched for the other agents sharing the account


def account_remaining(env):
    """Remaining account-level reads today (1Password SA quota is shared by
    every agent: 1000/day measured 2026-11-06). None if unknown."""
    r = subprocess.run(["op", "service-account", "ratelimit"], env=env, capture_output=True, text=True)
    rem = None
    for line in r.stdout.splitlines():
        w = line.split()
        if len(w) >= 5 and w[0] in ("account", "token") and w[1] in ("read", "read_write"):
            v = int(w[4]) if w[4].isdigit() else None
            if v is not None:
                rem = v if rem is None else min(rem, v)
    return rem


def load_vault_values(vaults, item=None):
    env = sa_env()
    out = {}
    rem = account_remaining(env)
    need = 2 if item else 450
    print(f"cota 1Password restante (menor entre token e conta): {rem}", file=sys.stderr)
    if rem is None or rem < need + RESERVE:
        STATE["aborted"] = True
        print(f"ABORTADO: precisa de ~450 leituras + reserva {RESERVE} para os outros agentes.", file=sys.stderr)
        return out
    reads = 0
    for vault in vaults:
        for wait in (0, 30, 90, 300):
            time.sleep(wait)
            lst = subprocess.run(["op", "item", "list", "--vault", vault, "--format", "json"],
                                 env=env, capture_output=True, text=True)
            if lst.returncode == 0 or "rate-limit" not in lst.stderr and "Too many" not in lst.stderr:
                break
        if lst.returncode != 0:
            print(f"ERRO: op item list --vault {vault} exit {lst.returncode}: {lst.stderr.strip()[:160]}", file=sys.stderr)
            continue
        ids = [x["id"] for x in json.loads(lst.stdout) if not item or x.get("title") == item]
        failed = 0
        for iid in ids:
            reads += 1
            if reads > rem - RESERVE:
                print(f"PARADO: teto de leituras ({rem - RESERVE}) atingido no cofre {vault}", file=sys.stderr)
                return out
            # shortcut: one read per item with backoff, because the SA is
            # rate-limited on bursts (measured: batch get died at item 59).
            for wait in (0, 20, 60, 120):
                time.sleep(wait or THROTTLE)
                got = subprocess.run(["op", "item", "get", iid, "--vault", vault, "--format", "json"],
                                     env=env, capture_output=True, text=True)
                if got.returncode == 0 or "rate-limit" not in got.stderr and "Too many" not in got.stderr:
                    break
            if got.returncode != 0:
                failed += 1
                continue
            obj = json.loads(got.stdout)
            del got
            for fld in obj.get("fields", []):
                val = fld.get("value")
                if fld.get("type") == "CONCEALED" and isinstance(val, str):
                    val = val.strip()
                    if len(val) >= MIN_LEN and "\n" not in val:
                        out.setdefault(val, (vault, obj.get("title", "?"), fld.get("label", "?")))
        print(f"cofre {vault}: {len(ids)} itens, {failed} falharam", file=sys.stderr)
    return out


def mask(text, values):
    for v in values:
        if v in text:
            text = text.replace(v, f"<VALUE:{h8(v)}>")
    return TOKENISH.sub(lambda m: f"<TOK:{len(m.group(0))}>", text)


def recent_files(roots, days):
    cut = time.time() - days * 86400
    for root in roots:
        root = os.path.expanduser(root)
        if os.path.isfile(root):
            if os.path.getmtime(root) >= cut:
                yield root
            continue
        for d, dirs, files in os.walk(root):
            dirs[:] = [x for x in dirs if x not in (".git", "node_modules", "browser-profile", "models", "engines")]
            for fn in files:
                p = os.path.join(d, fn)
                try:
                    st = os.lstat(p)
                except OSError:
                    continue
                if os.path.isfile(p) and not os.path.islink(p) and st.st_mtime >= cut:
                    yield p


def grep_values(files, values):
    grep = shutil.which("ggrep") or "grep"
    fd, pat = tempfile.mkstemp(prefix="sls-", dir=os.environ.get("TMPDIR"))
    hits = []
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(values) + "\n")
        files = list(files)
        for i in range(0, len(files), 500):
            chunk = files[i:i + 500]
            r = subprocess.run([grep, "-a", "-F", "-n", "-o", "-Z", "-H", "-f", pat, "--"] + chunk,
                               capture_output=True)
            for raw in r.stdout.split(b"\n"):
                if not raw or b"\0" not in raw:
                    continue
                path, rest = raw.split(b"\0", 1)
                ln, _, val = rest.partition(b":")
                hits.append((path.decode(errors="replace"), int(ln or 0),
                             val.decode("utf-8", "surrogateescape")))
    finally:
        os.unlink(pat)
    return hits


def context(path, line_no, value, values, width=160):
    try:
        with open(path, "rb") as f:
            for n, raw in enumerate(f, 1):
                if n == line_no:
                    s = raw.decode("utf-8", "replace")
                    k = s.find(value)
                    snip = s[max(0, k - width):k + len(value) + 60] if k >= 0 else s[:width]
                    return mask(snip.replace("\n", " "), values)
    except OSError:
        pass
    return ""


def gitleaks_scan(roots, days, values):
    cut = time.time() - days * 86400
    out = []
    for root in roots:
        root = os.path.expanduser(root)
        fd, rep = tempfile.mkstemp(prefix="slg-", suffix=".json", dir=os.environ.get("TMPDIR"))
        os.close(fd)
        os.chmod(rep, 0o600)
        try:
            subprocess.run(["gitleaks", "dir", root, "--no-banner", "--config", GL_CFG, "--log-level", "error",
                            "--report-format", "json", "--report-path", rep, "--exit-code", "0",
                            "--max-target-megabytes", "200"],
                           capture_output=True)
            try:
                data = json.load(open(rep))
            except (ValueError, OSError):
                data = []
            for f in data:
                p = f.get("File", "")
                if not os.path.isabs(p):
                    p = os.path.join(root, p)
                try:
                    if os.path.getmtime(p) < cut:
                        continue
                except OSError:
                    continue
                sec = f.get("Secret", "")
                out.append({"detector": "gitleaks", "path": p, "line": f.get("StartLine"),
                            "kind": f.get("RuleID"), "sha8": h8(sec),
                            "context": mask((f.get("Match") or "")[:200], values | {sec})})
        finally:
            os.unlink(rep)
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("roots", nargs="+")
    ap.add_argument("--days", type=float, default=30)
    ap.add_argument("--vaults", default=CONF.get("vaults", "eko"))
    ap.add_argument("--no-vault", action="store_true")
    ap.add_argument("--no-gitleaks", action="store_true")
    ap.add_argument("--patterns-file")
    ap.add_argument("--item", help="VAULT:TITLE - scan for one item only (2 reads); for incident containment")
    ap.add_argument("--json")
    a = ap.parse_args()

    findings = []
    if a.patterns_file:
        vals = {l.strip(): ("test", "patterns-file", "line")
                for l in open(a.patterns_file) if len(l.strip()) >= MIN_LEN}
    elif not a.no_vault:
        vaults, title = a.vaults.split(","), None
        if a.item:
            v, _, title = a.item.partition(":")
            vaults = [v]
        vals = load_vault_values(vaults, title)
    else:
        vals = {}
    print(f"valores carregados: {len(vals)}", file=sys.stderr)
    if vals:
        files = list(recent_files(a.roots, a.days))
        print(f"arquivos (<= {a.days:g} dias): {len(files)}", file=sys.stderr)
        for path, ln, val in grep_values(files, list(vals)):
            vault, title, label = vals.get(val, ("?", "?", "?"))
            findings.append({"detector": "vault-match", "path": path, "line": ln,
                             "kind": f"{vault}/{title}/{label}", "sha8": h8(val),
                             "context": context(path, ln, val, vals)})
    if not a.no_gitleaks:
        findings += gitleaks_scan(a.roots, a.days, set(vals))
    del vals

    for f in findings:
        print(f"{f['detector']}\t{f['path']}:{f['line']}\t{f['kind']}\tsha8={f['sha8']}")
    if a.json:
        fd = os.open(a.json, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(findings, fh, ensure_ascii=False, indent=1)
    print(f"achados: {len(findings)}", file=sys.stderr)
    if findings:
        return 1
    return 3 if STATE["aborted"] else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # never echo values: message only names the type
        print(f"ERRO: {type(e).__name__}", file=sys.stderr)
        sys.exit(2)
