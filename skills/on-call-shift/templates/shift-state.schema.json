{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "on-call-shift/state@2",
  "title": "on-call-shift persisted state",
  "description": "One document per shift, written atomically before and after every transition. Field rules: references/shift-contract.md.",
  "type": "object",
  "required": [
    "schema",
    "shift_id",
    "principal",
    "scope",
    "backlog",
    "capacity",
    "budget",
    "mantras",
    "mantras_source",
    "holder",
    "supervisor_target",
    "lease",
    "cursor",
    "processed_events",
    "effects",
    "adopted",
    "in_flight",
    "gates",
    "pending_events",
    "handoff",
    "status",
    "wakeup",
    "log",
    "generation",
    "successor_policy",
    "continuity",
    "deliveries",
    "reopened",
    "parked",
    "consumed_takeovers",
    "incident",
    "decisions",
    "admission",
    "children",
    "conflict_log",
    "team",
    "save_seq",
    "heartbeat",
    "stop"
  ],
  "properties": {
    "schema": {
      "const": "on-call-shift/state@2",
      "description": "state@2 = v0.3.0 (budget.money/deadline, heartbeat, stop); a state@1 (v0.2.0) file is migrated on load; a v0.2.0 engine's load() refuses state@2, but its load_checked() checks no schema and resumes it (with a count cap it ignores the money cap and the deadline: fail-open); after a rollback open a new shift"
    },
    "shift_id": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "backlog": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "reference to the principal's explicit list (path#section, URL, query): its items start with start_item; null ONLY when no list was given (then adopt)"
    },
    "backlog_exhausted": {
      "type": "boolean"
    },
    "capacity": {
      "type": "integer",
      "minimum": 1
    },
    "budget": {
      "type": "object",
      "required": [
        "limit",
        "spent",
        "money",
        "deadline"
      ],
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "maximum items taken (adoptions + started); null = not capped by count"
        },
        "spent": {
          "type": "integer",
          "minimum": 0
        },
        "money": {
          "type": [
            "object",
            "null"
          ],
          "description": "money cap measured as a delta from a baseline reading; admission freezes at freeze_at",
          "required": [
            "currency",
            "limit",
            "freeze_at",
            "baseline",
            "spent",
            "measured_at",
            "source",
            "inconsistent_at",
            "read_failed_at"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "freeze_at": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "baseline": {
              "type": [
                "number",
                "null"
              ]
            },
            "spent": {
              "type": "number",
              "minimum": 0
            },
            "measured_at": {
              "type": [
                "number",
                "null"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "inconsistent_at": {
              "type": [
                "number",
                "null"
              ],
              "description": "when the meter contradicted itself (went down, NaN, infinite, negative, not a number); sticky SPEND_UNMEASURABLE until the principal's rebaseline_spend"
            },
            "read_failed_at": {
              "type": [
                "number",
                "null"
              ],
              "description": "when a read of the ledger failed (a None reading); SPEND_NOT_READ blocks new work until the next good reading, never sticky"
            }
          }
        },
        "deadline": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMaximum": 100000000000,
          "description": "epoch SECONDS, UTC (a millisecond epoch is refused); required (a number) whenever money is set; at or after it no new work starts and the holder closes at cutoff; the opening log echoes it as deadline_utc"
        }
      },
      "if": {
        "required": [
          "money"
        ],
        "properties": {
          "money": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "deadline": {
            "type": "number"
          }
        }
      }
    },
    "mantras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "mantras_source": {
      "enum": [
        "explicit",
        "default"
      ]
    },
    "holder": {
      "type": "string",
      "minLength": 1
    },
    "supervisor_target": {
      "type": "string",
      "minLength": 1
    },
    "lease": {
      "type": "object",
      "required": [
        "holder",
        "expires_at",
        "lease_secs"
      ],
      "properties": {
        "holder": {
          "type": "string"
        },
        "expires_at": {
          "type": "number"
        },
        "lease_secs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cursor": {
      "type": "object",
      "required": [
        "seq",
        "last_event_id"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "last_event_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "processed_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "adopted": {
      "type": "object",
      "description": "every item taken into the shift: intent key -> {refs, at, via backlog (start_item, the principal's list) | adoption (adopt, found in trackers)}"
    },
    "in_flight": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "object"
    },
    "pending_events": {
      "type": "object"
    },
    "handoff": {
      "type": [
        "object",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "HANDOFF_PENDING",
        "STOPPED",
        "REVOKED"
      ]
    },
    "wakeup": {
      "type": "object",
      "required": [
        "mode",
        "reason",
        "recovery",
        "always_on_claim"
      ],
      "properties": {
        "mode": {
          "enum": [
            "SUPPORTED",
            "DEGRADED"
          ]
        },
        "transport": {
          "type": [
            "string",
            "null"
          ]
        },
        "bound_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "recovery": {
          "type": [
            "string",
            "null"
          ]
        },
        "always_on_claim": {
          "const": false
        }
      }
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "description": "fencing token; +1 on every relief or takeover; a write with an older value is refused"
    },
    "successor_policy": {
      "type": [
        "object",
        "null"
      ],
      "description": "armed by the principal for ONE generation; consumed by the takeover it allows; never names the current holder",
      "required": [
        "pre_authorized",
        "armed_by",
        "armed_generation",
        "nonce"
      ],
      "properties": {
        "pre_authorized": {
          "type": "string",
          "minLength": 1
        },
        "armed_by": {
          "type": "string",
          "minLength": 1
        },
        "armed_generation": {
          "type": "integer",
          "minimum": 1
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "continuity": {
      "type": "object",
      "required": [
        "mode",
        "reason",
        "uninterrupted_claim"
      ],
      "properties": {
        "mode": {
          "enum": [
            "SUPPORTED",
            "DEGRADED"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "uninterrupted_claim": {
          "const": false
        }
      }
    },
    "deliveries": {
      "type": "object",
      "description": "per intent key: technical_verified, delivered_to_recipient, satisfaction (confirmed|refused|unknown), recipient, recipient_kind, attempts, result_ref, reservations, reopened_as",
      "additionalProperties": {
        "type": "object",
        "required": [
          "technical_verified",
          "delivered_to_recipient",
          "satisfaction"
        ],
        "properties": {
          "technical_verified": {
            "type": "boolean"
          },
          "delivered_to_recipient": {
            "type": "boolean"
          },
          "satisfaction": {
            "enum": [
              "confirmed",
              "refused",
              "unknown"
            ]
          },
          "recipient_kind": {
            "enum": [
              "human",
              "agent",
              null
            ]
          }
        }
      }
    },
    "reopened": {
      "type": "object",
      "description": "reopened intent key -> {reopens, result_ref, note, at}"
    },
    "parked": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "operations stopped by the blast-radius check"
    },
    "consumed_takeovers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "nonces of policies already used; a replay with one is refused"
    },
    "incident": {
      "type": [
        "object",
        "null"
      ],
      "description": "open incident; preempts backlog; never moves the cursor",
      "properties": {
        "id": {
          "type": "string"
        },
        "opened_at": {
          "type": "number"
        },
        "cursor_at_open": {
          "type": "object"
        }
      }
    },
    "decisions": {
      "type": "object",
      "description": "decision key -> {choice, seen (source#digest), changes [{from,to,evidence,lens,at}]}; a repeated source#digest never changes the choice"
    },
    "admission": {
      "type": "object",
      "required": [
        "open",
        "reason"
      ],
      "properties": {
        "open": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "closed on persistence failure, preflight freeze, fencing, postflight, the cutoff (DEADLINE_REACHED, SPEND_CAP_REACHED) or an inconsistent spend reading; no new item starts while closed"
    },
    "children": {
      "type": "object",
      "description": "child id -> {ref, sha256, received}; the child keeps its own checkpoint",
      "additionalProperties": {
        "type": "object",
        "required": [
          "ref",
          "sha256",
          "received"
        ]
      }
    },
    "conflict_log": {
      "type": "object",
      "description": "conflict id -> {facts, authorities, alternatives, reversible, review_criterion, decision, status, reason, at}"
    },
    "team": {
      "type": "object",
      "required": [
        "seats",
        "members"
      ],
      "properties": {
        "seats": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "object",
          "description": "member id -> {owner, role, scope, risk, cost, mode ephemeral|persistent, review_at, disarm, status admitted|active|draining|retired, in_flight, admitted_at, exit_receipt}"
        }
      }
    },
    "save_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "monotonic count of save attempts (failed ones too); a checkpoint with a lower or equal value than a failed save cannot recover it"
    },
    "heartbeat": {
      "type": "object",
      "description": "the holder's own scheduled wakeup (OMP: a background job whose completion starts a follow-up turn); armed at most half a lease ahead, consumed by the tick it produces",
      "required": [
        "transport",
        "job_ref",
        "armed_at",
        "fires_at",
        "bound_target"
      ],
      "properties": {
        "transport": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "armed_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "fires_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "bound_target": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stop": {
      "type": [
        "object",
        "null"
      ],
      "description": "how the shift ended; null while it runs",
      "required": [
        "kind",
        "by",
        "reason",
        "at",
        "in_flight_left"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cutoff",
            "principal_stop",
            "principal_revoke"
          ]
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "number"
        },
        "in_flight_left": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
