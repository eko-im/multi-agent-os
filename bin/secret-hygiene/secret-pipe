#!/usr/bin/python3
"""secret-pipe: hand 1Password secrets to a process without them ever passing
through the agent's context (stdout, transcript, argv, disk).

  secret-pipe [SPEC | --stdin SPEC] -- CMD ARGS...     value -> CMD stdin
  secret-pipe --env NAME SPEC [--env NAME2 SPEC2 ...] -- CMD ARGS...
                                                       values -> env of CMD only
  secret-pipe --file SPEC -- CMD ... {} ...            value -> temp file 0600,
                                                       {} = its path, removed at the end
  (the options combine: one --stdin, one --file, any number of --env)

SPEC is `op://vault/item/field` or `vault:item title:field label`.
Vault must be listed in `vaults=` of ~/.config/secret-hygiene/config (default: eko);
any other vault (e.g. Personal) is refused.

Quota rules (1Password service accounts, official limits on
https://www.1password.dev/service-accounts/rate-limits/ : per token 1,000
reads/h and 100 writes/h on Families/Teams; per ACCOUNT 1,000 requests/day on
1Password/Families, 5,000 Teams, 50,000 Business; this account measured
1,000/day):
- one `op item get` per ITEM per process: several fields or several SPECs of
  the same item cost one read (in-memory cache, never written to disk);
- a cross-process lock per item, so two agents never read the same item in
  parallel;
- on rate-limit: up to 4 retries with exponential backoff and full jitter
  (base 5 s, cap 120 s). On the DAILY limit it stops at once: retrying cannot help.

Python scripts can import it and reuse the same cache for a whole run:
  sp = SourceFileLoader("sp", shutil.which("secret-pipe")).load_module(); v = sp.get("eko:X:password")

The SA token is read from the configured env file into the `op` child only.
CMD's stdout/stderr are streamed with every value replaced by <secret:sha8>.
"""
import fcntl, hashlib, json, os, random, subprocess, sys, tempfile, threading, time


def local_config():
    """Optional ~/.config/secret-hygiene/config with key=value lines:
    vaults=eko,other  sa_env=/path/to/sa.env"""
    c = {}
    try:
        for line in open(os.path.expanduser("~/.config/secret-hygiene/config")):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                c[k.strip()] = v.strip()
    except OSError:
        pass
    return c


CONF = local_config()
SA_ENV = os.path.expanduser(CONF.get("sa_env", "~/.config/op/service-accounts/ai-agents.env"))
AGENT_VAULTS = set(CONF.get("vaults", "eko").split(","))
LOCK_DIR = os.path.expanduser("~/.local/state/secret-guard/locks")
RETRIES, BASE, CAP = 4, 5.0, 120.0
_ITEMS = {}           # (vault, item) -> parsed item JSON; process memory only
_MEM_LOCK = threading.Lock()


class SecretError(Exception):
    pass


def die(msg, code=2):
    print(f"secret-pipe: {msg}", file=sys.stderr)
    sys.exit(code)


def sa_env():
    env = {k: v for k, v in os.environ.items() if not k.startswith("OP_SESSION_") and k != "OP_DEVICE"}
    with open(SA_ENV) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.replace("export ", "").strip()] = v.strip().strip('"').strip("'")
    return env


def parse(spec):
    if spec.startswith("op://"):
        parts = spec[5:].split("/")
        if len(parts) < 3:
            raise SecretError("op:// precisa de vault/item/field")
        vault, item, field = parts[0], "/".join(parts[1:-1]), parts[-1]
    else:
        try:
            vault, item, field = spec.split(":", 2)
        except ValueError:
            raise SecretError("SPEC deve ser op://vault/item/field ou vault:item:field")
    if vault not in AGENT_VAULTS:
        raise SecretError(f"cofre '{vault}' fora do domínio do agente ({', '.join(sorted(AGENT_VAULTS))})")
    return vault, item, field


def _rate_limited(err):
    e = err.lower()
    return "too many requests" in e or "rate-limit" in e or "rate limit" in e


def _daily(err):
    return "daily" in err.lower()


def _op_item(vault, item, sleep=time.sleep, run=subprocess.run):
    os.makedirs(LOCK_DIR, mode=0o700, exist_ok=True)
    lock = os.path.join(LOCK_DIR, hashlib.sha256(f"{vault}\0{item}".encode()).hexdigest()[:16] + ".lock")
    with open(lock, "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)          # one reader of this item at a time, host-wide
        try:
            env = sa_env()
            for attempt in range(RETRIES + 1):
                p = run(["op", "item", "get", item, "--vault", vault, "--format", "json"],
                        env=env, capture_output=True, text=True)
                if p.returncode == 0:
                    return json.loads(p.stdout)
                err = p.stderr.strip()
                if not _rate_limited(err) or _daily(err) or attempt == RETRIES:
                    raise SecretError(f"op falhou (exit {p.returncode}): {err[:160]}")
                sleep(random.uniform(0, min(CAP, BASE * 2 ** attempt)))   # full jitter
        finally:
            fcntl.flock(lf, fcntl.LOCK_UN)


def get(spec, **kw):
    """Value for SPEC. Same item -> one read per process (memory cache)."""
    vault, item, field = parse(spec)
    with _MEM_LOCK:
        obj = _ITEMS.get((vault, item))
        if obj is None:
            obj = _ITEMS[(vault, item)] = _op_item(vault, item, **kw)
    flds = [f for f in obj.get("fields", [])
            if field in (f.get("label"), f.get("id")) and isinstance(f.get("value"), str)]
    if not flds:
        raise SecretError(f"campo '{field}' não existe no item")
    if not flds[0]["value"]:
        raise SecretError("valor vazio; nada foi entregue")
    return flds[0]["value"]


def pump(src, dst, vals):
    forms = {}
    for v in vals:
        tag = f"<secret:{hashlib.sha256(v.encode()).hexdigest()[:8]}>"
        forms[v] = tag
        forms[json.dumps(v)[1:-1]] = tag
    order = sorted((f for f in forms if f), key=len, reverse=True)
    for chunk in iter(lambda: src.readline(), b""):
        s = chunk.decode("utf-8", "surrogateescape")
        for f in order:
            s = s.replace(f, forms[f])
        dst.write(s.encode("utf-8", "surrogateescape"))
        dst.flush()


def parse_args(argv):
    stdin_spec = file_spec = None
    envs = []
    i = 0
    while i < len(argv) and argv[i] != "--":
        a = argv[i]
        if a == "--env" and i + 2 < len(argv):
            envs.append((argv[i + 1], argv[i + 2]))
            i += 3
        elif a == "--file" and i + 1 < len(argv):
            file_spec = argv[i + 1]
            i += 2
        elif a == "--stdin" and i + 1 < len(argv):
            stdin_spec = argv[i + 1]
            i += 2
        elif not a.startswith("--") and stdin_spec is None:
            stdin_spec = a
            i += 1
        else:
            die(f"opção inválida: {a}")
    cmd = argv[i + 1:]
    if i >= len(argv) or not cmd or not (stdin_spec or file_spec or envs):
        die("uso: secret-pipe [SPEC|--stdin SPEC] [--env NOME SPEC]... [--file SPEC] -- CMD ...")
    return stdin_spec, file_spec, envs, cmd


def main(argv):
    stdin_spec, file_spec, envs, cmd = parse_args(argv)
    try:
        sval = get(stdin_spec) if stdin_spec else None
        fval = get(file_spec) if file_spec else None
        evals = [(n, get(s)) for n, s in envs]
    except SecretError as e:
        die(str(e))
    vals = [v for v in [sval, fval] + [v for _, v in evals] if v]
    env = {k: v for k, v in os.environ.items() if k != "OP_SERVICE_ACCOUNT_TOKEN"}
    env.update(dict(evals))
    path = None
    try:
        if fval is not None:
            fd, path = tempfile.mkstemp(prefix="sp-")
            os.fchmod(fd, 0o600)
            os.write(fd, fval.encode())
            os.close(fd)
            cmd = [path if a == "{}" else a for a in cmd]
        proc = subprocess.Popen(cmd, env=env, stdin=subprocess.PIPE if sval is not None else subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        ts = [threading.Thread(target=pump, args=(proc.stdout, sys.stdout.buffer, vals)),
              threading.Thread(target=pump, args=(proc.stderr, sys.stderr.buffer, vals))]
        for t in ts:
            t.start()
        if sval is not None:
            try:
                proc.stdin.write(sval.encode())
                proc.stdin.close()
            except BrokenPipeError:
                pass
        rc = proc.wait()
        for t in ts:
            t.join()
        return rc
    finally:
        if path and os.path.exists(path):
            os.unlink(path)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
