#!/usr/bin/python3
"""secret-guard: PreToolUse gate that blocks shell commands which would put a
secret value into the model's context (tool stdout/stderr, transcript, argv).

Reads the hook event JSON on stdin (Claude Code, kiro-cli or Kiro Crew shape:
any string under a key named "command" is checked). Exit 2 + reason on stderr
= block; exit 0 = allow.

shortcut: internal errors exit 0 (fail-open) so a guard bug never freezes
every shell call of every session; upgrade to fail-closed once it has run a
few weeks without false blocks.

Escape hatch for a human-reviewed command: put the comment `# secret-guard:ok`
in it. Every block is logged (rule + sha8 of the command, never the command)
to ~/.local/state/secret-guard/blocks.log.
"""
import hashlib, json, os, re, sys, time

SECRET_VAR = r"[A-Za-z0-9_]*(?:TOKEN|SECRET|PASSW(?:OR)?D|PASS|API_?KEY|PRIVATE_?KEY|CREDENTIAL|_PW)[A-Za-z0-9_]*"
SECRET_REF = re.compile(r"\$\{?#?!?" + SECRET_VAR + r"(?![A-Za-z0-9_])", re.I)
SECRET_FILE = re.compile(
    r"(service-accounts/|\.env\b|secrets\.json|/\.aws/credentials|\.netrc|id_(?:rsa|ed25519|ecdsa)\b(?!\.pub)"
    r"|\.pem\b|\.p12\b|\.codex/config\.toml|\.claude\.json\b|\.git-credentials|\.pgpass|\.npmrc|\.pypirc)")
OK_MARK = "# secret-guard:ok"

RULES = []


def rule(fn):
    RULES.append(fn)
    return fn


def segments(cmd):
    """Split a command line into simple commands, keeping the separator that
    follows each one: '|', '>', ')' (end of a $( ) capture) or ';'."""
    out, cur, i, q = [], [], 0, None
    depth = []  # stack of open '$(' (True) vs '(' (False)
    while i < len(cmd):
        c = cmd[i]
        if q:
            cur.append(c)
            if c == q and (q == "'" or cmd[i - 1] != "\\"):
                q = None
            elif q == '"' and cmd.startswith("$(", i):
                # command substitution inside double quotes
                out.append(("".join(cur[:-1]), "open$"))
                cur = []
                depth.append(("$", q))
                q = None
                i += 2
                continue
            i += 1
            continue
        if c in "'\"":
            q = c
            cur.append(c)
        elif cmd.startswith("$(", i):
            out.append(("".join(cur), "open$"))
            cur = []
            depth.append(("$", None))
            i += 2
            continue
        elif c == "`":
            out.append(("".join(cur), "open$"))
            cur = []
            i += 1
            j = cmd.find("`", i)
            j = len(cmd) if j < 0 else j
            out.append((cmd[i:j], ")$"))
            i = j + 1
            continue
        elif c == "(":
            out.append(("".join(cur), ";"))
            cur = []
            depth.append(("(", None))
        elif c == ")":
            kind, restore = depth.pop() if depth else ("(", None)
            out.append(("".join(cur), ")$" if kind == "$" else ";"))
            cur = []
            if restore:
                q = restore
        elif cmd.startswith("||", i) or cmd.startswith("&&", i):
            out.append(("".join(cur), ";"))
            cur = []
            i += 2
            continue
        elif c == "|":
            out.append(("".join(cur), "|"))
            cur = []
        elif c == ">" or (c == "&" and cmd.startswith("&>", i)):
            # stdout goes to a file: whatever follows is a path, not output
            sep = ">"
            if cur and cur[-1] == "2" and (len(cur) < 2 or cur[-2] in " \t"):
                sep = "2>"  # only stderr redirected; stdout still reaches us
            out.append(("".join(cur), sep))
            cur = []
            j = i + 1
            while j < len(cmd) and cmd[j] in ">&| \t":
                j += 1
            while j < len(cmd) and cmd[j] not in " \t;|&\n)":
                j += 1
            i = j
            continue
        elif c in ";\n&":
            out.append(("".join(cur), ";"))
            cur = []
        else:
            cur.append(c)
        i += 1
    out.append(("".join(cur), ";"))
    return [(s.strip(), sep) for s, sep in out if s.strip()]


def stdout_reaches_model(segs, idx):
    """True if segment idx's stdout ends up as tool output."""
    sep = segs[idx][1]
    return sep not in ("|", ">", ")$")


def words(seg):
    return re.findall(r"""(?:[^\s'"]+|'[^']*'|"[^"]*")+""", seg)


def head(seg):
    w = [x for x in words(seg) if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", x)]
    while len(w) > 1 and w[0] in ("sudo", "command", "exec", "time", "nohup", "env", "builtin"):
        w = w[1:]
    return (w[0].rsplit("/", 1)[-1] if w else ""), w


@rule
def op_reveal_unpiped(cmd, segs):
    for i, (s, _) in enumerate(segs):
        h, w = head(s)
        if h != "op":
            continue
        a = " ".join(w[1:])
        reveal = re.match(r"read\b", a) or (re.match(r"item\s+get\b", a) and "--reveal" in a) \
            or (re.match(r"item\s+get\b", a) and "--format" in a and "json" in a)
        if reveal and stdout_reaches_model(segs, i):
            return ("op-reveal-unpiped",
                    "o valor do 1Password iria para a saída da ferramenta. Entregue por pipe "
                    "(op read ... | cmd), capture em variável VAR=$(op read ...) sem ecoar, "
                    "ou use op run / op inject / secret-pipe.")
        if re.search(r"\brun\b", a) and "--no-masking" in a:
            return ("op-run-no-masking", "op run --no-masking desliga a máscara da saída. Tire a flag.")
    return None


@rule
def echo_secret_var(cmd, segs):
    for i, (s, _) in enumerate(segs):
        h, w = head(s)
        if h in ("echo", "printf", "print", "cat") and SECRET_REF.search(s) and stdout_reaches_model(segs, i):
            m = SECRET_REF.search(s)
            ref = m.group(0)
            if ref.startswith("${#") or re.search(r"\$\{" + SECRET_VAR + r":\+[^}$]*\}", s, re.I) \
                    and not re.search(r"\$\{" + SECRET_VAR + r"(?::-|-|:=|=|\})", s, re.I):
                continue  # only length / presence test: no value printed
            return ("echo-secret-var",
                    f"o comando imprime uma variável de segredo ({ref.split(':')[0]}...). "
                    "Para checar, use ${#VAR} ou [ -n \"$VAR\" ]; para entregar, use pipe para o processo.")
        if h in ("printenv",) and stdout_reaches_model(segs, i):
            return ("printenv", "printenv mostra valores de ambiente. Use [ -n \"$VAR\" ] ou ${#VAR}.")
        if h in ("env", "set", "export", "declare", "typeset") and stdout_reaches_model(segs, i) \
                and (len(w) == 1 or (h != "set" and len(w) == 2 and w[1] in ("-p", "-x"))):
            return ("dump-env", f"'{s}' despeja o ambiente inteiro, com tokens. Filtre só nomes: env | cut -d= -f1.")
    return None


@rule
def xtrace(cmd, segs):
    if re.search(r"(?:\bset\s+-[a-zA-Z]*x|\bset\s+-o\s+xtrace|\b(?:ba|z)?sh\s+-[a-zA-Z]*x)", cmd) and \
            (re.search(r"\bop\s", cmd) or SECRET_REF.search(cmd) or "service-accounts" in cmd):
        return ("xtrace-with-secret", "set -x/bash -x imprime cada linha já expandida, com o segredo. Tire o -x.")
    return None


@rule
def cat_secret_file(cmd, segs):
    readers = ("cat", "head", "tail", "less", "more", "bat", "strings", "xxd", "od", "hexdump",
               "nl", "tac", "jq", "yq", "sed", "awk", "grep", "rg", "cut", "base64")
    for i, (s, _) in enumerate(segs):
        h, w = head(s)
        if h in readers and SECRET_FILE.search(s) and stdout_reaches_model(segs, i):
            if h in ("grep", "rg") and re.search(r"\s-(?:[a-zA-Z]*[clLq])\b|--count|--files", s):
                continue
            if h == "jq" and re.search(r"\b(keys|length|type)\b", s):
                continue
            return ("cat-secret-file",
                    "o comando mostra um arquivo de segredo. Use source dentro de subshell, "
                    "ou mostre só nomes (cut -d= -f1, jq keys).")
    return None


@rule
def secret_printing_cli(cmd, segs):
    for i, (s, _) in enumerate(segs):
        h, w = head(s)
        a = " ".join(w[1:])
        if h == "aws" and re.search(r"secretsmanager\s+(get-secret-value|batch-get-secret-value)", a):
            return ("aws-get-secret-value",
                    "proibido pela regra AWS: use asm-exec com {{resolve:secretsmanager:...}}.")
        hit = (h == "gh" and re.match(r"auth\s+token\b", a)) \
            or (h == "kubectl" and re.search(r"\bget\s+secrets?\b", a) and re.search(r"-o\s*(yaml|json|jsonpath)|--output", a)) \
            or (h == "security" and re.search(r"find-(generic|internet)-password\b.*\s-w\b", a)) \
            or (h == "git" and re.match(r"credential\s+fill\b", a)) \
            or (h in ("fly", "flyctl") and re.match(r"(auth\s+token|tokens\s+create)\b", a)) \
            or (h == "doppler" and re.match(r"secrets\s+get\b", a))
        if hit and stdout_reaches_model(segs, i):
            return ("cli-prints-secret", f"'{h} {a[:30]}' imprime o segredo. Capture em variável ou mande por pipe.")
    return None


@rule
def secret_in_argv(cmd, segs):
    argv_tools = ("curl", "wget", "http", "https", "mysql", "psql", "redis-cli", "sshpass", "mongosh",
                  "gh", "aws", "docker", "git", "npm", "twine", "valkey-cli")
    for s, _ in segs:
        h, w = head(s)
        if h == "gh" and re.search(r"\bsecret\s+set\b", s) and re.search(r"\s(--body|-b)(\s|=|$)", s):
            return ("gh-secret-body", "gh secret set --body põe o valor em argv. Mande por stdin: ... | gh secret set NOME.")
        if h in argv_tools and len(w) > 1:
            args = " ".join(w[1:])
            if SECRET_REF.search(args) or re.search(r"--password[= ]\S", args) and "--password-stdin" not in args:
                m = SECRET_REF.search(args)
                if m and m.group(0).startswith("${#"):
                    continue
                return ("secret-in-argv",
                        f"o segredo iria em argv de '{h}' (visível em ps e no log). Use stdin, "
                        "arquivo 0600 (curl -H @arquivo, --config -), ou variável de ambiente que o programa lê.")
    return None


def check(cmd):
    if OK_MARK in cmd:
        return None
    segs = segments(cmd)
    for r in RULES:
        res = r(cmd, segs)
        if res:
            return res
    return None


def commands(obj):
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k in ("command", "cmd") and isinstance(v, str):
                yield v
            elif isinstance(v, str) and k in ("input", "arguments", "tool_input") and v.lstrip().startswith("{"):
                try:
                    yield from commands(json.loads(v))
                except ValueError:
                    pass
            else:
                yield from commands(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from commands(v)


SECRET_PATH = re.compile(
    r"(/service-accounts/[^/]+$|(^|/)\.env$|[^/]\.env$|/secrets\.json$|/\.aws/credentials$|/\.netrc$"
    r"|/id_(rsa|ed25519|ecdsa)$|\.pem$|\.p12$|/\.codex/config\.toml$|/\.claude\.json$|/\.git-credentials$|/\.pgpass$)")


def read_paths(ev):
    """Paths a read-type tool (Read, read_file, fs_read, view) is about to open."""
    name = str(ev.get("tool_name") or ev.get("tool") or "")
    if not re.search(r"read|view|^cat$", name, re.I) or re.search(r"bash|shell|command", name, re.I):
        return []
    out = []

    def walk(o):
        if isinstance(o, dict):
            for k, v in o.items():
                if k in ("path", "file_path", "filePath", "paths") and isinstance(v, (str, list)):
                    out.extend([v] if isinstance(v, str) else [x for x in v if isinstance(x, str)])
                else:
                    walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)
    walk(ev.get("tool_input") or ev.get("input") or ev.get("arguments") or {})
    return [p for p in out if SECRET_PATH.search(os.path.expanduser(p))]


def log_block(rid, cmd):
    try:
        d = os.path.expanduser("~/.local/state/secret-guard")
        os.makedirs(d, mode=0o700, exist_ok=True)
        fd = os.open(os.path.join(d, "blocks.log"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {rid} cmd_sha8={hashlib.sha256(cmd.encode()).hexdigest()[:8]}\n"
        os.write(fd, line.encode())
        os.close(fd)
    except OSError:
        pass


def main():
    raw = sys.stdin.read()
    if len(sys.argv) > 2 and sys.argv[1] == "--check":
        cmds = [sys.argv[2]]
    else:
        try:
            ev = json.loads(raw)
        except ValueError:
            return 0
        cmds = list(commands(ev))
        if isinstance(ev, dict):
            if isinstance(ev.get("input"), str) and ev["input"].lstrip().startswith("{"):
                try:
                    ev = {**ev, "input": json.loads(ev["input"])}
                except ValueError:
                    pass
            hits = read_paths(ev)
            if hits:
                log_block("read-secret-file", hits[0])
                print("secret-guard BLOQUEOU (read-secret-file): a ferramenta de leitura ia trazer um arquivo "
                      "de segredo para o contexto. Leia só nomes por shell (cut -d= -f1, jq keys).", file=sys.stderr)
                return 2
    for c in cmds:
        res = check(c)
        if res:
            rid, why = res
            log_block(rid, c)
            print(f"secret-guard BLOQUEOU ({rid}): {why} "
                  f"Doutrina: ~/.kiro/steering/secrets-1password.md §Never through the model.", file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
