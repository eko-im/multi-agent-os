#!/usr/bin/python3
"""secret-alert: PostToolUse detector. Runs gitleaks (high-confidence rules
only, config next to this file) over the hook event on stdin, which carries the
tool's output. Hooks cannot rewrite a tool result (Kiro Crew: PostToolUse exit
is warn-only; Claude Code Bash output is not rewritable), so this only DETECTS:

- appends `ts session rule sha8` to ~/.local/state/secret-guard/alerts.log
  (never the value);
- exits 2 with a short notice on stderr (Claude Code feeds it to the model,
  so the agent knows not to repeat the value; Kiro records it on the hook row).

Exit 0 when nothing is found or on any internal error (never blocks work).
"""
import hashlib, json, os, subprocess, sys, tempfile, time

HERE = os.path.dirname(os.path.realpath(__file__))
CFG = os.path.join(HERE, "gitleaks-agent.toml")
GITLEAKS = next((p for p in ("/opt/homebrew/bin/gitleaks", "/usr/local/bin/gitleaks") if os.path.exists(p)), "gitleaks")


def main():
    raw = sys.stdin.buffer.read()
    if len(raw) < 20:
        return 0
    try:
        ev = json.loads(raw)
    except ValueError:
        ev = {}
    fd, rep = tempfile.mkstemp(prefix="sa-", suffix=".json")
    os.close(fd)
    try:
        subprocess.run([GITLEAKS, "stdin", "--no-banner", "--log-level", "error", "--config", CFG,
                        "--report-format", "json", "--report-path", rep, "--exit-code", "0"],
                       input=raw, capture_output=True, timeout=20)
        found = json.load(open(rep)) if os.path.getsize(rep) else []
    finally:
        os.unlink(rep)
    if not found:
        return 0
    sess = ev.get("session_key") or ev.get("session_id") or os.environ.get("KIRO_SESSION_ID") or "?"
    d = os.path.expanduser("~/.local/state/secret-guard")
    os.makedirs(d, mode=0o700, exist_ok=True)
    lines = []
    for f in found:
        sha8 = hashlib.sha256((f.get("Secret") or "").encode()).hexdigest()[:8]
        lines.append(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} session={sess} rule={f.get('RuleID')} sha8={sha8}\n")
    fdl = os.open(os.path.join(d, "alerts.log"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    os.write(fdl, "".join(lines).encode())
    os.close(fdl)
    rules = sorted({f.get("RuleID") for f in found})
    print(f"secret-alert: a saída desta ferramenta contém segredo ({', '.join(rules)}). "
          "Não repita, não copie, não resuma o valor. Registro: ~/.local/state/secret-guard/alerts.log",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
