#!/usr/bin/python3
"""secret-pipe: hand a 1Password secret to a process without it ever passing
through the agent's context (stdout, transcript, argv, disk).

  secret-pipe SPEC -- CMD [ARGS...]              value -> CMD stdin
  secret-pipe --env NAME SPEC -- CMD [ARGS...]   value -> env NAME of CMD only
  secret-pipe --file SPEC -- CMD ... {} ...      value -> temp file 0600, {} = its path,
                                                 file removed when CMD ends

SPEC is `op://vault/item/field` or `vault:item title:field label`.
Vault must be listed in `vaults=` of ~/.config/secret-hygiene/config (default: eko);
any other vault (e.g. Personal) is refused.
The SA token is read from ~/.config/op/service-accounts/ai-agents.env into the
`op` child only. CMD's stdout/stderr are streamed with every occurrence of the
value replaced by <secret:sha8>, so an echoing CMD cannot leak it either.

Example (site login on a VM):
  secret-pipe 'eko:Some Login:password' -- ssh my-vm 'python3 ~/login.py'
"""
import hashlib, json, os, subprocess, sys, tempfile, threading

def local_config():
    """Optional ~/.config/secret-hygiene/config with key=value lines:
    vaults=eko,other  sa_env=/path/to/sa.env"""
    c = {}
    try:
        for line in open(os.path.expanduser("~/.config/secret-hygiene/config")):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                c[k.strip()] = v.strip()
    except OSError:
        pass
    return c


CONF = local_config()
SA_ENV = os.path.expanduser(CONF.get("sa_env", "~/.config/op/service-accounts/ai-agents.env"))
AGENT_VAULTS = set(CONF.get("vaults", "eko").split(","))


def die(msg, code=2):
    print(f"secret-pipe: {msg}", file=sys.stderr)
    sys.exit(code)


def sa_env():
    env = {k: v for k, v in os.environ.items() if not k.startswith("OP_SESSION_") and k != "OP_DEVICE"}
    with open(SA_ENV) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.replace("export ", "").strip()] = v.strip().strip('"').strip("'")
    return env


def fetch(spec):
    if spec.startswith("op://"):
        vault = spec[5:].split("/", 1)[0]
        argv = ["op", "read", "--no-newline", spec]
    else:
        try:
            vault, item, field = spec.split(":", 2)
        except ValueError:
            die("SPEC deve ser op://vault/item/field ou vault:item:field")
        argv = ["op", "item", "get", item, "--vault", vault, "--format", "json"]
    if vault not in AGENT_VAULTS:
        die(f"cofre '{vault}' fora do domínio do agente ({', '.join(sorted(AGENT_VAULTS))})")
    p = subprocess.run(argv, env=sa_env(), capture_output=True, text=True)
    if p.returncode != 0:
        # op error messages carry no value; still cut them short
        die(f"op falhou (exit {p.returncode}): {p.stderr.strip()[:160]}")
    if argv[1] == "read":
        val = p.stdout
    else:
        flds = [f for f in json.loads(p.stdout).get("fields", [])
                if field in (f.get("label"), f.get("id")) and isinstance(f.get("value"), str)]
        if not flds:
            die(f"campo '{field}' não existe no item")
        val = flds[0]["value"]
    del p
    if not val:
        die("valor vazio; nada foi entregue")
    return val


def pump(src, dst, val, tag):
    forms = {val, json.dumps(val)[1:-1]}
    for chunk in iter(lambda: src.readline(), b""):
        s = chunk.decode("utf-8", "surrogateescape")
        for f in forms:
            if f:
                s = s.replace(f, tag)
        dst.write(s.encode("utf-8", "surrogateescape"))
        dst.flush()


def main(argv):
    mode, name = "stdin", None
    if argv[:1] == ["--env"]:
        mode, name, argv = "env", argv[1], argv[2:]
    elif argv[:1] == ["--file"]:
        mode, argv = "file", argv[1:]
    if len(argv) < 3 or argv[1] != "--":
        die(__doc__.strip().splitlines()[2].strip())
    spec, cmd = argv[0], argv[2:]
    val = fetch(spec)
    tag = f"<secret:{hashlib.sha256(val.encode()).hexdigest()[:8]}>"
    env = {k: v for k, v in os.environ.items() if k != "OP_SERVICE_ACCOUNT_TOKEN"}
    path = None
    try:
        if mode == "env":
            env[name] = val
        elif mode == "file":
            fd, path = tempfile.mkstemp(prefix="sp-")
            os.fchmod(fd, 0o600)
            os.write(fd, val.encode())
            os.close(fd)
            cmd = [path if a == "{}" else a for a in cmd]
        proc = subprocess.Popen(cmd, env=env, stdin=subprocess.PIPE if mode == "stdin" else subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        ts = [threading.Thread(target=pump, args=(proc.stdout, sys.stdout.buffer, val, tag)),
              threading.Thread(target=pump, args=(proc.stderr, sys.stderr.buffer, val, tag))]
        for t in ts:
            t.start()
        if mode == "stdin":
            try:
                proc.stdin.write(val.encode())
                proc.stdin.close()
            except BrokenPipeError:
                pass
        rc = proc.wait()
        for t in ts:
            t.join()
        return rc
    finally:
        if path and os.path.exists(path):
            os.unlink(path)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
